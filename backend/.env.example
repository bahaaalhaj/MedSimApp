# Copy this file to `backend/.env.local` and fill in the values.
# The backend reads these at startup — restart the server after editing.
#
# WARNING: .env.local is gitignored. Never commit API keys.

# Shared only between the deployed backend and Vercel Edge middleware.
BACKEND_SHARED_SECRET=replace-with-a-long-random-production-value

# Anthropic API key for the Managed Agent (medsim-attending). Server-side only —
# never set this in a VITE_* variable and never return it to the browser.
ANTHROPIC_API_KEY=

# Cached IDs for the persistent Managed Agent + Environment.
# First run: leave these blank, start the server, POST /agent/bootstrap,
# then paste the returned `agent_id` / `environment_id` back here and
# restart. Subsequent runs are no-ops.
MEDSIM_AGENT_ID=
MEDSIM_ENV_ID=

# Authentication database and cookie settings. The SQLite file is created by
# migrations on startup and is gitignored. Use an absolute path in production.
MEDSIM_DATABASE_PATH=backend/data/medsim.db
MEDSIM_ENVIRONMENT=development
MEDSIM_SESSION_HOURS=24
MEDSIM_REMEMBER_DAYS=30
MEDSIM_COOKIE_SECURE=0
MEDSIM_COOKIE_SAMESITE=lax
# MEDSIM_COOKIE_DOMAIN=

# Local patient speech. Kokoro is the default; disabled keeps text-only mode.
PATIENT_TTS_PROVIDER=kokoro
PATIENT_TTS_DEVICE=auto
PATIENT_TTS_FALLBACK=disabled
PATIENT_TTS_MODEL_CACHE_DIR=backend/data/tts-models
PATIENT_TTS_ENABLE_CHATTERBOX=false
PATIENT_TTS_SPEED=1.0
PATIENT_TTS_LANGUAGE=en

# Optional fake credential-vault demo token.
EHR_API_TOKEN=
