# Copy this file to `backend/.env.local` and fill in the values.
# The backend reads these at startup â€” restart the server after editing.
#
# WARNING: .env.local is gitignored. Never commit API keys.

# Shared only between the deployed backend and Vercel Edge middleware.
BACKEND_SHARED_SECRET=replace-with-a-long-random-production-value

# Hosted inference is the default. The user-approved free Mini model is pinned;
# browser code cannot override any of these values.
MEDSIM_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_FALLBACK_MODELS=nex-agi/nex-n2.5-pro:free
# Pro remains supported but is disabled after its 20% / 15.02 s benchmark.
OPENROUTER_PRO_FALLBACK_ENABLED=false
OPENROUTER_TIMEOUT_SECONDS=7
OPENROUTER_PATIENT_TIMEOUT_SECONDS=3
OPENROUTER_MAX_RETRIES=0
OPENROUTER_ALLOW_PAID_MODELS=false
MEDSIM_LOCAL_LLM_ENABLED=false

# Optional offline llama.cpp configuration. It is used only when both
# MEDSIM_LLM_PROVIDER=llama_cpp and MEDSIM_LOCAL_LLM_ENABLED=true.
MEDSIM_LLM_BASE_URL=http://127.0.0.1:8080/v1
MEDSIM_LLM_PATIENT_MODEL=qwen3-local
# Optional diagnostic path; the startup script supplies its selected model.
MEDSIM_LLM_MODEL_PATH=
MEDSIM_LLM_CONTEXT_SIZE=4096
MEDSIM_LLM_MAX_CONCURRENCY=1
MEDSIM_LLM_THINKING=false
MEDSIM_LLM_TIMEOUT_SECONDS=60
MEDSIM_LLM_GPU_OFFLOAD=auto
MEDSIM_LLM_EVALUATION_MODE=hybrid

# Authentication database and cookie settings. Relative paths are rooted at the
# repository application root, so this resolves identically from the repository
# root and the backend directory. The SQLite file is created by migrations on
# startup and is gitignored. Use an absolute path in production.
MEDSIM_DATABASE_PATH=backend/data/medsim.db
MEDSIM_ENVIRONMENT=development
MEDSIM_SESSION_HOURS=24
MEDSIM_REMEMBER_DAYS=30
MEDSIM_COOKIE_SECURE=0
MEDSIM_COOKIE_SAMESITE=lax
# MEDSIM_COOKIE_DOMAIN=

# Local patient speech. Kokoro is the default; disabled keeps text-only mode.
PATIENT_TTS_PROVIDER=kokoro
PATIENT_TTS_DEVICE=auto
PATIENT_TTS_FALLBACK=disabled
# Run backend/.venv/Scripts/python.exe backend/prepare_kokoro.py once before MedSim.
# Runtime validates this cache, then forces offline mode before importing Kokoro.
PATIENT_TTS_MODEL_CACHE_DIR=~/.cache/huggingface
PATIENT_TTS_AUDIO_CACHE_DIR=~/.cache/medsim/tts
PATIENT_TTS_AUDIO_CACHE_MAX_MB=512
PATIENT_TTS_ENABLE_CHATTERBOX=false
PATIENT_TTS_SPEED=1.0
PATIENT_TTS_LANGUAGE=en
