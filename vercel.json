{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist-demo",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "docs/generated/{curation-manifest.json,investigation-manifest.server.json,local-ai-manifest.server.json}",
      "excludeFiles": "{!(api|backend){,/**},api/!(index.py){,/**},backend/{!(medsim_backend|local_@(ai|llm).py|patient_@(memory|interpretation).py){,/**},medsim_backend/{**/!(*.py|routes|services){,/**},@(runtime|pilot).py,routes/diagnostics.py}},**/.*{,/**}}"
    }
  },
  "routes": [
    { "src": "/(api|agent)(/.*)?", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/(?:tts|backend|docs|src|node_modules|\\..*)(?:/.*)?", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404 }
  ]
}
