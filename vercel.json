{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://grand-rounds-backend.onrender.com/api/:path*" },
    { "source": "/agent/:path*", "destination": "https://grand-rounds-backend.onrender.com/agent/:path*" },
    { "source": "/voice/:path*", "destination": "https://grand-rounds-backend.onrender.com/voice/:path*" },
    { "source": "/:path*", "destination": "/" }
  ]
}
