{
  "name": "medsim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "verify": "node scripts/verify/run-all.ts",
    "test": "node scripts/test/run-all.ts",
    "clinical:validate": "node scripts/clinical/validate.ts",
    "clinical:references": "node scripts/clinical/references.ts",
    "clinical:audit": "node scripts/clinical/audit.ts",
    "clinical:export-review": "node --max-old-space-size=8192 scripts/clinical/export-review.ts",
    "clinical:export-curation": "node scripts/clinical/export-curation.ts",
    "clinical:export-local-ai": "node scripts/clinical/export-local-ai-manifest.ts",
    "clinical:verify-curation": "node scripts/clinical/verify-curation.ts",
    "clinical:validate-investigations": "node scripts/clinical/validate-investigations.ts",
    "clinical:export-investigations": "node scripts/clinical/export-investigation-manifest.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
